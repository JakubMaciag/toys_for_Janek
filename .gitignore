# Compiled class file
*.class

# Log file
*.log

# BlueJ files
*.ctxt

# Mobile Tools for Java (J2ME)
.mtj.tmp/

# Package Files #
*.jar
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar

# virtual machine crash logs, see http://www.java.com/en/download/help/error_hotspot.xml
hs_err_pid*
replay_pid*

# Firebase service-account keys — NEVER commit these (used only locally by scripts/set-admin-claim.js)
service-account*.json
*firebase-adminsdk*.json

# Node (scripts/set-admin-claim.js dependencies)
node_modules/

# Extension config holds a real API key and isn't deployed via GitHub Actions
# (the extension is loaded unpacked straight from disk), so it's kept out of
# git entirely instead of using a repo secret. Copy config.example.js to
# config.js locally and fill in real values — see SETUP.md.
extension/config.js

