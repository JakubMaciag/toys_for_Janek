rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() { return request.auth != null; }
    function isAdmin() { return isSignedIn() && request.auth.token.admin == true; }

    match /toys/{toyId} {
      function hasOnlyToyFields(data) {
        return data.keys().hasOnly([
          'name', 'price', 'originalPrice', 'currency', 'link', 'imageUrl', 'adminComment', 'ageCategory',
          'addedAt', 'reserved', 'reservedByName', 'reservedAt'
        ]);
      }

      function isValidAgeCategory(cat) {
        return cat in [
          '0-6 miesięcy', '6-12 miesięcy', '1-2 lata', '2-3 lata',
          '3-4 lata', '4-5 lat', '5-6 lat', '6+ lat'
        ];
      }

      function isValidToyShape(data) {
        return hasOnlyToyFields(data)
          && data.name is string && data.name.size() > 0 && data.name.size() <= 200
          && data.link is string && data.link.size() <= 2000 && data.link.matches('^https?://.+')
          && (data.price == null || (data.price is number && data.price >= 0 && data.price <= 1000000))
          && (!('originalPrice' in data) || data.originalPrice == null || (data.originalPrice is number && data.originalPrice >= 0 && data.originalPrice <= 1000000))
          && data.currency is string && data.currency.size() <= 10
          && (data.imageUrl == null || (data.imageUrl is string && data.imageUrl.size() <= 2000 && data.imageUrl.matches('^https?://.+')))
          && (!('adminComment' in data) || data.adminComment == null || (data.adminComment is string && data.adminComment.size() <= 300))
          && (!('ageCategory' in data) || data.ageCategory == null || (data.ageCategory is string && isValidAgeCategory(data.ageCategory)))
          && data.addedAt is timestamp
          && data.reserved is bool
          && (data.reservedByName == null || (data.reservedByName is string && data.reservedByName.size() <= 60))
          && (data.reservedAt == null || data.reservedAt is timestamp);
      }

      function isWithinReservationTimeWindow(ts) {
        return ts <= request.time + duration.value(10, 'm') && ts >= request.time - duration.value(10, 'm');
      }

      function isGuestReservation() {
        let changed = request.resource.data.diff(resource.data).affectedKeys();
        return changed.hasOnly(['reserved', 'reservedByName', 'reservedAt'])
          && resource.data.reserved == false
          && request.resource.data.reserved == true
          && (request.resource.data.reservedByName == null || (request.resource.data.reservedByName is string && request.resource.data.reservedByName.size() <= 60))
          && request.resource.data.reservedAt is timestamp
          && isWithinReservationTimeWindow(request.resource.data.reservedAt);
      }

      allow read: if isSignedIn();
      allow create: if isAdmin() && isValidToyShape(request.resource.data);
      allow update: if (isAdmin() && isValidToyShape(request.resource.data)) || (isSignedIn() && isGuestReservation());
      allow delete: if isAdmin();
    }

    // Separate record of toys Janek already has/already bought — unrelated to
    // the guest wishlist/reservation flow above. Writes are admin-only; reads
    // are open to any signed-in user (guests included, same as `toys`) so the
    // guest page can show "Janek already has this" to avoid duplicate gifts.
    // NOTE: Firestore rules gate whole documents, not individual fields, and
    // can't cheaply condition a `list` query on `visibleToGuests` without a
    // matching `where` clause (which would need runQuery instead of the plain
    // GET this app uses everywhere else) — so this rule does NOT enforce
    // visibleToGuests or hide price server-side. The guest UI just filters to
    // visibleToGuests == true and never renders price, same cosmetic-only
    // pattern as reservedByName/the guest password elsewhere in this app.
    match /ownedToys/{itemId} {
      function hasOnlyOwnedFields(data) {
        return data.keys().hasOnly(['name', 'price', 'currency', 'link', 'imageUrl', 'adminComment', 'visibleToGuests', 'addedAt']);
      }

      function isValidOwnedShape(data) {
        return hasOnlyOwnedFields(data)
          && data.name is string && data.name.size() > 0 && data.name.size() <= 200
          && (data.link == null || (data.link is string && data.link.size() <= 2000 && data.link.matches('^https?://.+')))
          && (data.price == null || (data.price is number && data.price >= 0 && data.price <= 1000000))
          && data.currency is string && data.currency.size() <= 10
          && (data.imageUrl == null || (data.imageUrl is string && data.imageUrl.size() <= 2000 && data.imageUrl.matches('^https?://.+')))
          && (!('adminComment' in data) || data.adminComment == null || (data.adminComment is string && data.adminComment.size() <= 300))
          && (!('visibleToGuests' in data) || data.visibleToGuests is bool)
          && data.addedAt is timestamp;
      }

      allow read: if isSignedIn();
      allow create, update: if isAdmin() && isValidOwnedShape(request.resource.data);
      allow delete: if isAdmin();
    }

    // Holds two admin-configured, publicly-readable settings docs:
    //   - "guestGate" { passwordSha256 } — the guest-page password hash, so
    //     it lives in Firestore instead of the git repo (cosmetic deterrent
    //     only, see SETUP.md — moving it here stops it sitting in git
    //     history and lets the admin rotate it without a commit+push).
    //   - "settings" { currentAgeCategory } — which age-category toys are
    //     currently appropriate for Janek, used to split the guest wishlist
    //     into "buy now" vs "buy later" sections.
    // Both public-readable on purpose (guest page needs them before/without
    // a real login), admin-only writable.
    match /appConfig/{doc} {
      allow read: if true;
      allow write: if isAdmin() && (
        (doc == 'guestGate'
          && request.resource.data.keys().hasOnly(['passwordSha256'])
          && request.resource.data.passwordSha256 is string
          && request.resource.data.passwordSha256.size() == 64)
        ||
        (doc == 'settings'
          && request.resource.data.keys().hasOnly(['currentAgeCategory'])
          && request.resource.data.currentAgeCategory is string)
      );
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
